boolean montMax<E>( <E>[] array ) {
  int cont = 0;
  int talla = array.length
  for(int i = 1; i<talla ; i++){

    if(i <= talla && array[i] < array[i+1]) { cont++;}
  }

  if(cont == talla){
    return true;
  } else {
    return false;
  }
}
//Corrección:
